rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nash marshrut: friends use it by link, without sign-in.
    match /trips/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() < 120
        && request.resource.data.members is list
        && request.resource.data.members.size() < 60;
      allow delete: if false;
    }
    match /places/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.tripId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() < 200
        && request.resource.data.keys().size() < 30;
      allow delete: if true;
    }
    // Shared expenses: amount in cents, split = who shares it equally.
    match /expenses/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.tripId is string
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount < 100000000
        && request.resource.data.paidBy is string
        && request.resource.data.split is list
        && request.resource.data.split.size() > 0
        && request.resource.data.split.size() < 60
        && request.resource.data.keys().size() < 20;
      allow delete: if true;
    }
    // Live positions on the map: one doc per trip member, only while they share.
    match /live/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.tripId is string
        && request.resource.data.name is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.keys().size() < 12;
      allow delete: if true;
    }
  }
}
